{
  "name": "codexeurope",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "codexeurope.com", "custom_domain": true },
    { "pattern": "www.codexeurope.com", "custom_domain": true }
  ]
}
